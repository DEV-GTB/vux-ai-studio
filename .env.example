# Copy this file to .env and fill in your own values locally.
# Do not commit .env with real secrets or keys.

# --- Gemini AI ---
# Create a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview

# --- Security ---
# Recommended before public hosting. Use a long random value.
APP_ACCESS_CODE=
ALLOWED_ORIGIN=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=40

PORT=3000