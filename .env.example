# Pollinations (free music/audio/image generation - get key at https://enter.pollinations.ai)
# IMPORTANT: Get a FREE API key at https://enter.pollinations.ai/keys for watermark-free images!
# Without a key, free tier adds watermarks and has rate limits (1 image per 45 seconds).
# With a free key (sk_...), images are watermark-free and unlimited.
POLLINATIONS_API_KEY=

# VUX Studio / Project tab settings
STUDIO_MAX_ASSET_BYTES=209715200  # 200 MB asset budget per project
